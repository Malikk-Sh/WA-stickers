<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TextAppearance.WA.ScreenTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textSize">@dimen/type_screen_title</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WA.SectionTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textSize">@dimen/type_section_title</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WA.CardTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textSize">@dimen/type_card_title</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WA.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="TextAppearance.WA.Label" parent="android:style/TextAppearance.Material.Body2">
        <item name="android:textSize">@dimen/type_label</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WA.Metadata" parent="android:style/TextAppearance.Material.Body2">
        <item name="android:textSize">@dimen/type_metadata</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <style name="TextAppearance.WA.Caption" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">@dimen/type_caption</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
</resources>
